# Secrets — never commit
.env
.env.*

# Dependencies (symlinked into a shared tree)
node_modules/

# OS / editor cruft
Thumbs.db
Desktop.ini
*.log

# Office temp files
~$*

# Session / runtime
.claude/

# Test coverage output
coverage/

# Husky internals (auto-generated by `husky`); the hook scripts are tracked
.husky/_/

# Cargo test-fixture OUTPUT copies — each run of excel_real_file.rs /
# powerpoint_real_file.rs / legacy_office_formats.rs / text_formats.rs
# writes a fresh "sample[-legacy] L<n>[ <m>].ext" beside the tracked
# source fixture (sample.xlsx / sample.pptx / sample-legacy.doc / etc).
# Only the source fixtures are tracked; the auto-incrementing run
# outputs are regenerable.
humanize/src-tauri/tests/fixtures/sample L*.xlsx
humanize/src-tauri/tests/fixtures/sample L*.pptx
humanize/src-tauri/tests/fixtures/sample L*.md
humanize/src-tauri/tests/fixtures/sample L*.txt
humanize/src-tauri/tests/fixtures/sample-legacy L*.doc
humanize/src-tauri/tests/fixtures/sample-legacy L*.xls
humanize/src-tauri/tests/fixtures/sample-legacy L*.ppt

