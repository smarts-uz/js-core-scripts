{
    "name": "js_ai_category",
    "version": "1.0.4",
    "description": "Node.js (ESM) CLI tools for processing Office and Markdown documents on Windows.",
    "type": "module",
    "private": true,
    "license": "MIT",
    "author": "Asror Zakirov <asror.zk@gmail.com>",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "generate:runners": "node runs/_generate.mjs",
        "generate:readme": "node runs/_gen-readme.mjs",
        "generate:shell": "node runs/_wire-shell.mjs",
        "generate:launch": "node runs/_wire-launch.mjs",
        "prepare": "husky"
    },
    "lint-staged": {
        "!(runs/*/**).{js,mjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,yml,yaml,md}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@fast-check/jest": "^2.0.3",
        "cross-env": "^7.0.3",
        "eslint": "^9.17.0",
        "globals": "^15.14.0",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "jest-extended": "^4.0.2",
        "jest-watch-typeahead": "^2.2.2",
        "jest-when": "^3.6.0",
        "lint-staged": "^15.3.0",
        "prettier": "^3.4.2"
    },
    "dependencies": {
        "@anthropic-ai/claude-code": "^2.1.204",
        "@composio/mcp": "^1.0.9",
        "@google/gemini-cli": "^0.49.0",
        "@lydell/node-pty": "^1.2.0-beta.12",
        "@lydell/node-pty-win32-x64": "^1.2.0-beta.14",
        "@modelcontextprotocol/server-filesystem": "^2026.7.4",
        "@modelcontextprotocol/server-sequential-thinking": "^2026.7.4",
        "@openai/codex": "^0.143.0",
        "@playwright/mcp": "^0.0.77",
        "@upstash/context7-mcp": "^3.2.3",
        "@yao-pkg/pkg": "^6.21.0",
        "adm-zip": "0.5.16",
        "agent-browser": "^0.31.1",
        "bower": "^1.8.14",
        "bun": "^1.3.14",
        "chrome-devtools-mcp": "^1.5.0",
        "corepack": "^0.35.0",
        "dayjs": "^1.11.19",
        "dot-prop": "^10.1.0",
        "dotenv": "^17.4.2",
        "fs-extra": "^8.1.0",
        "js-yaml": "4.1.1",
        "libqp": "^2.1.1",
        "marked": "^15.0.12",
        "marked-footnote": "^1.4.0",
        "marked-katex-extension": "^5.1.10",
        "npm": "^11.18.0",
        "number-to-words-ru": "2.4.1",
        "ofetch": "^1.5.1",
        "open": "^11.0.0",
        "p-retry": "^8.0.0",
        "pino": "^10.3.1",
        "pino-roll": "^4.0.0",
        "pnpm": "^11.10.0",
        "postject": "^1.0.0-alpha.6",
        "puppeteer": "24.34.0",
        "skills": "^1.5.15",
        "supabase": "^2.109.1",
        "tree-kill": "^1.2.2",
        "turndown": "^7.2.0",
        "turndown-plugin-gfm": "^1.0.2",
        "undici": "^7.20.0",
        "user-agents": "^1.1.668",
        "vercel": "^54.21.1",
        "winax": "3.6.9",
