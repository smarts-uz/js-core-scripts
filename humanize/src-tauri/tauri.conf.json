{
    "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "humanize",
    "version": "0.1.0",
    "identifier": "com.jsaicategory.humanize",
    "build": {
        "frontendDist": "../src",
        "devUrl": "http://localhost:1420"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "Humanize — Homoglyph Replace",
                "width": 800,
                "height": 600,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "android": {
            "debugApplicationIdSuffix": ".debug"
        }
    }
}
